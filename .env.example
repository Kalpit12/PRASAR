# Copy to .env and set DATABASE_URL (Supabase → Project Settings → Database → Connection string → Transaction pooler).
# PRASAR project: https://kwleffsyfvslellxmnrk.supabase.co
DATABASE_URL=postgresql://postgres.kwleffsyfvslellxmnrk:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# First administrator (created/updated on server start — required to sign in)
# PRASAR_BOOTSTRAP_ADMIN_EMAIL=admin@your-org.org
# PRASAR_BOOTSTRAP_ADMIN_PASSWORD=choose-a-long-unique-password
# Optional test volunteer
# PRASAR_BOOTSTRAP_VOLUNTEER_EMAIL=volunteer@your-org.org
# PRASAR_BOOTSTRAP_VOLUNTEER_PASSWORD=choose-a-long-unique-password

# Postmark (optional) — transactional email; same vars as AksharJobs.
# POSTMARK_API_KEY=
# POSTMARK_SENDER_EMAIL=noreply@your-verified-domain.com
# POSTMARK_SENDER_NAME=PRASAR
# Optional: POSTMARK_REPLY_TO=  POSTMARK_MESSAGE_STREAM=outbound

# Public site URL (for BAPS logo in invitation HTML). On Vercel, VERCEL_URL is used if this is unset.
# PUBLIC_APP_URL=https://prasar.vercel.app

# Security (optional)
# NODE_ENV=production
# ALLOWED_ORIGINS=https://prasar.vercel.app
# PRASAR_EMAIL_RATE_LIMIT_PER_HOUR=120
# PRASAR_KARYAKAR_LOGIN_MAX_PER_15M=40
# PRASAR_RSVP_RATE_LIMIT_MAX=60
# PRASAR_API_RATE_LIMIT_MAX=500
# PRASAR_BACKUP_HTTP_TOKEN=long-random-secret
# TRUST_PROXY=1
# PGSSL_REJECT_UNAUTHORIZED=1
